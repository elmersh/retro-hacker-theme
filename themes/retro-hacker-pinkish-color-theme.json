{
    //════════════════════════════════════════════════════════════════════════
    // RETRO HACKER PINK v2 · neon magenta sobre negro, synthwave hacker
    // Archivo GENERADO por build/generate.js desde build/palettes/pink.js: no editar a mano.
    //════════════════════════════════════════════════════════════════════════
    // Paleta (rol → hex → significado). * = valor por defecto (fallback) del rol
    // ── Fondos ──────────────────────────────────────────────────────────────
    // bg0                    #010001    fondo del editor, gutter, sticky scroll
    // bgDeep                 #000000    fondo mas profundo: terminal, tab activa
    // bg1                    #0A000A    sidebar, region sin cambios del diff
    // bg2                    #110411    panel, output, sticky del terminal
    // bg3                    #1F0A1F    widgets: find, suggest, hover, inputs, menus, quick input
    // bg4                    #371337    headers elevados: peek title, keybinding label, banner
    // bgPeek                 #140414    editor del peek view
    // bgHover                #2E132E    hover del sticky scroll (editor y terminal)
    // bgActive               #330033    base del hover de tabs (se usa con alpha)
    // lineHighlight          #2E132E7A  linea activa (scanline), admite alpha
    // lineHighlightBorder    #5E135E7C  borde de la linea activa, admite alpha
    // bgSideHeader           #0E010E    headers de seccion del sidebar
    // bgActivityBar          #180818    activity bar
    // bgTitleBar             #110611    title bar activa
    // bgTitleBarInactive     #110011    title bar sin foco
    // bgCommandCenter        #130513    command center
    // bgCommandCenterActive  #2C002C    command center activo
    // bgStatusBar            #140014    status bar
    // errorBg                #2A0808    fondo opaco de validacion: error
    // warningBg              #2A1A04    fondo opaco de validacion: warning
    // infoBg                 #02262A    fondo opaco de validacion: info
    // exceptionBg            #1A0505    widget de excepcion del debugger
    // ── Bordes ──────────────────────────────────────────────────────────────
    // border                 #AA00AA    bordes estructurales (sidebar, panel, tabs, widgets)
    // focus                  #E000E0    focusBorder, inputs, widgets activos, badge
    // borderDim              #411541    separadores suaves, overview ruler
    // ── UI: acentos y texto ─────────────────────────────────────────────────
    // uiAccent               #FF00FF    IDENTIDAD: acento UI, foreground general, botones, iconos
    // uiAccentAlt            #FF69B4    acento secundario: highlight con foco en listas/suggest, headers del sidebar
    // uiAccentCool           #00E5FF    acento frio: cursores secundarios, renamed, pasos del debugger, chat
    // uiAccentWarm           #FFD700    acento calido: lightbulb, estrellas, pickerGroup, sin carpeta
    // onAccent               #000000    texto sobre rellenos de uiAccent (botones, badges, remoto)
    // onSignal               #000000    texto sobre rellenos de error/warning/debug/offline
    // cursor                 #FF00FF    cursor del editor y del terminal
    // uiText                 #E04FE0    texto de sidebar, descripciones
    // uiTitle                #E85AE8    titulo del sidebar
    // uiTextBright           #FFFFFF    texto de items seleccionados / en hover
    // uiTextSoft             #FFE0FF    texto de seleccion inactiva en listas
    // textNeutral            #D8B8D8    texto de lineas en el resultado del peek
    // textDim                #D062D0    texto secundario: tabs inactivas, codelens, puntuacion de markup
    // tabUnfocusedText       #A040A0    tabs inactivas de un grupo sin foco
    // textGhost              #A878A8    ghost text, blame, placeholders, tachado
    // textDisabled           #8A608A    elementos deshabilitados
    // ignored                #9A6A9A    archivos ignorados por git
    // inactiveIcon           #9A709A    iconos inactivos (breakpoint deshabilitado, test sin correr)
    // lineNumber             #C050C0    numeros de linea, guia de indent activa
    // guide                  #4E1E4E    guias de indentacion
    // guideStrong            #8A458A    whitespace, guias del arbol, numeros de linea atenuados
    // terminalText           #F040F0    texto del terminal
    // inlayHint              #C890C8    inlay hints (parametros)
    // inlayHintType          #8FBFD8    inlay hints de tipo
    // ── Estados ─────────────────────────────────────────────────────────────
    // error                  #FF3C3C    SOLO errores, invalid, breakpoints
    // errorSoft              #FF7070    errores en listas, hover de error, referencias sin resolver
    // warning                #FF9F1C    warnings, deprecated
    // warningHover           #FFB54D    hover del item warning de la status bar
    // info                   #00E5FF    info, consola de debug, alertas note
    // success                #5CFF9D    tests pasados, comando exitoso, start del debugger
    // attention              #FF6F3C    conflictos git, offline, alertas important, sponsor
    // attentionHover         #FF8F66    hover del item offline
    // debug                  #FF9F1C    status bar en debug, stack frame en pausa
    // ── Diff y control de versiones ─────────────────────────────────────────
    // inserted               #5CFF9D    texto agregado: markup.inserted, archivos agregados, lineas +
    // deleted                #FF3C3C    texto/gutter borrado
    // modified               #FFD700    gutter y archivos modificados, tab modificada
    // changed                #FF9F1C    markup.changed en diffs
    // diffAdded              #00D070    gutter agregado y fondos de diff agregado (con alpha)
    // mergeCurrent           #5CFF9D    merge: current
    // mergeIncoming          #00E5FF    merge: incoming
    // mergeBase              #FFD700    merge: base comun
    // ── Highlights ──────────────────────────────────────────────────────────
    // selection              #B480FF    seleccion y sus ocurrencias (con alpha)
    // findMatch              #FF9F1C    resultados de busqueda (con alpha)
    // highlightRead          #FF00FF    word highlight de lectura (con alpha)
    // highlightWrite         #00E5FF    word highlight de escritura, linked editing (con alpha)
    // bracketMatch           #FF69B4    bracket match
    // bracket1               #FF00FF    ciclo de brackets: nivel 1/4
    // bracket2               #00E5FF    ciclo de brackets: nivel 2/5
    // bracket3               #FF9F1C    ciclo de brackets: nivel 3/6
    // ── Sintaxis ────────────────────────────────────────────────────────────
    // text                   #F4DCEF    IDENTIDAD: editor.foreground, texto JSX, codigo embebido
    // keyword                #FF55FF    keywords, storage, imports, directivas
    // tag                    #FF55FF    tags HTML/XML, selectores de tag CSS
    // func                   #C88CFF    funciones, metodos, decorators, selectores de clase CSS
    // type                   #00E5FF    tipos, clases, interfaces, componentes
    // namespace              #8FA0FF    namespaces, modulos, type params, lifetimes, fechas de log
    // variable               #FFB8EC    variables
    // parameter              #FFB8EC    parametros
    // property               #FF79C6    propiedades, keys JSON/YAML/CSS/ini
    // attribute              #FF79C6    atributos de markup
    // string                 #FFD700    strings, valores CSS/dotenv
    // number                 #FF9F1C    numeros, booleans, null, constantes del lenguaje
    // constant               #FF9F1C    constantes UPPER_CASE/readonly, enum members, labels
    // regexp                 #40FFD0    expresiones regulares
    // escape                 #40FFD0    escapes, placeholders, delimitadores ${ }, entidades
    // special                #40FFD0    macros, !important, eventos
    // comment                #B084B0    comentarios, citas Markdown
    // operator               #FF2AA0    operadores, separadores
    // punctuation            #D070D0    puntuacion y brackets (sin colorizar)
    // selfVar                #FFD700    this / self / super / cls
    // link                   #00E5FF    links (UI y URLs de Markdown)
    // linkActive             #8FA0FF    link activo, texto de links Markdown
    // markupHeading          #FF00FF    headings Markdown, secciones INI
    // markupBold             #FF55FF    Markdown bold
    // markupItalic           #FFB8EC    Markdown italic
    // markupCode             #FF9F1C    codigo inline (Markdown, hovers)
    // ── Terminal: paleta ANSI 16 ────────────────────────────────────────────
    // ansiBlack              #1F0F1F    terminal.ansiBlack
    // ansiRed                #FF3C3C    terminal.ansiRed
    // ansiGreen              #5CFF9D    terminal.ansiGreen
    // ansiYellow             #FFD700    terminal.ansiYellow
    // ansiBlue               #5C8FFF    terminal.ansiBlue
    // ansiMagenta            #B44DFF    terminal.ansiMagenta
    // ansiCyan               #00C8E0    terminal.ansiCyan
    // ansiWhite              #D8B8D8    terminal.ansiWhite
    // ansiBrightBlack        #8A6A8A    terminal.ansiBrightBlack
    // ansiBrightRed          #FF7070    terminal.ansiBrightRed
    // ansiBrightGreen        #9DFFC4    terminal.ansiBrightGreen
    // ansiBrightYellow       #FFFF5C    terminal.ansiBrightYellow
    // ansiBrightBlue         #8FB8FF    terminal.ansiBrightBlue
    // ansiBrightMagenta      #D69BFF    terminal.ansiBrightMagenta
    // ansiBrightCyan         #5CF5FF    terminal.ansiBrightCyan
    // ansiBrightWhite        #FFF2FF    terminal.ansiBrightWhite
    // ── fontStyle ───────────────────────────────────────────────────────────
    // comment=italic · keyword=bold · tag=bold · declaration=bold · parameter=italic · selfVar=bold italic · decorator=italic · attribute=italic · heading=bold
    // ── Reglas de la casa ───────────────────────────────────────────────────
    // · rojo solo para errores · verde solo para insertado/exito y ANSI
    // · bold = keywords, tags y declaraciones; nunca expresiones completas (meta.*)
    // · seleccion violeta, find ambar, word highlight magenta (lectura) / cyan (escritura)
    //════════════════════════════════════════════════════════════════════════
    "$schema": "vscode://schemas/color-theme",
    "name": "Retro Hacker Pink",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
