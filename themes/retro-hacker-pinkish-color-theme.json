    "semanticTokenColors": {
        // ── Tipos base
        "namespace": "#8FA0FF",
        "type": "#00E5FF",
        "class": "#00E5FF",
        "struct": "#00E5FF",
        "enum": "#00E5FF",
        "interface": { "foreground": "#00E5FF", "italic": true },
        "typeParameter": { "foreground": "#8FA0FF", "italic": true },
        "function": "#C88CFF",
        "method": "#C88CFF",
        "macro": { "foreground": "#40FFD0", "bold": true },
        "decorator": { "foreground": "#C88CFF", "italic": true },
        "variable": "#FFB8EC",
        "parameter": { "foreground": "#FFB8EC", "italic": true },
        "property": "#FF79C6",
        "enumMember": "#FF9F1C",
        "event": "#40FFD0",
        "label": { "foreground": "#FF9F1C", "italic": true },
        "keyword": "#FF55FF",
        "modifier": "#FF55FF",
        "comment": { "foreground": "#B084B0", "italic": true },
        "string": "#FFD700",
        "number": "#FF9F1C",
        "regexp": "#40FFD0",
        "operator": "#FF2AA0",

        // ── Modificadores: declaraciones (fontStyle.declaration, solo simbolos grandes)
        "function.declaration": { "bold": true },
        "method.declaration": { "bold": true },
        "class.declaration": { "bold": true },
        "struct.declaration": { "bold": true },
        "interface.declaration": { "bold": true },
        "enum.declaration": { "bold": true },
        "type.declaration": { "bold": true },
        "namespace.declaration": { "bold": true },

        // ── Modificadores: readonly / constantes (constant)
        "variable.readonly": "#FFB8EC",
        "property.readonly": "#FF79C6",
        "variable.readonly.defaultLibrary": "#FF9F1C",
        "property.readonly.defaultLibrary": { "foreground": "#FF9F1C", "italic": true },

        // ── Modificadores: libreria estandar (italic)
        "variable.defaultLibrary": { "foreground": "#8FA0FF", "italic": true },
        "function.defaultLibrary": { "foreground": "#C88CFF", "italic": true },
        "method.defaultLibrary": { "foreground": "#C88CFF", "italic": true },
        "class.defaultLibrary": { "foreground": "#00E5FF", "italic": true },
        "type.defaultLibrary": { "foreground": "#00E5FF", "italic": true },
        "interface.defaultLibrary": { "foreground": "#00E5FF", "italic": true },
        "namespace.defaultLibrary": { "foreground": "#8FA0FF", "italic": true },
        "property.defaultLibrary": { "foreground": "#FF79C6", "italic": true },

        // ── Modificadores: estado
        "*.deprecated": { "strikethrough": true },
        "*.async": { "italic": true },
        "*.static": { "italic": true },
        "*.abstract": { "italic": true },

        // ── Python (Pylance)
        "selfParameter": { "foreground": "#FFD700", "bold": true, "italic": true },
        "clsParameter": { "foreground": "#FFD700", "bold": true, "italic": true },
        "magicFunction": { "foreground": "#C88CFF", "italic": true },
        "builtinConstant": "#FF9F1C",
        "module": "#8FA0FF",

        // ── Rust (rust-analyzer) y C/C++ (clangd)
        "selfKeyword": { "foreground": "#FFD700", "bold": true, "italic": true },
        "selfTypeKeyword": { "foreground": "#00E5FF", "bold": true, "italic": true },
        "lifetime": { "foreground": "#8FA0FF", "italic": true },
        "builtinType": "#00E5FF",
        "typeAlias": "#00E5FF",
        "trait": { "foreground": "#00E5FF", "italic": true },
        "attribute": { "foreground": "#C88CFF", "italic": true },
        "builtinAttribute": { "foreground": "#C88CFF", "italic": true },
        "formatSpecifier": "#40FFD0",
        "escapeSequence": "#40FFD0",
        "unresolvedReference": { "foreground": "#FF7070", "underline": true },
        "boolean": "#FF9F1C",
        "character": "#FF9F1C",
        "constParameter": { "foreground": "#FF9F1C", "italic": true }
    }
}
