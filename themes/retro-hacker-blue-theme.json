        // ── Editor: fondo, cursor, linea activa (scanline CRT)
        "editor.background": "#010111",
        "editor.foreground": "#E4ECFF",
        "editorCursor.foreground": "#7CBEFF",
        "editorCursor.background": "#000010",
        "editorMultiCursor.primary.foreground": "#7CBEFF",
        "editorMultiCursor.secondary.foreground": "#3FE0C5",
        "editor.lineHighlightBackground": "#0C2B5E7A",
        "editor.lineHighlightBorder": "#12397E7C",
        "editorLineNumber.foreground": "#4F86C8",
        "editorLineNumber.activeForeground": "#5EAFFF",
        "editorLineNumber.dimmedForeground": "#2C5AA0",
        "editor.foldBackground": "#5EAFFF0D",
        "editor.foldPlaceholderForeground": "#6296DA",
