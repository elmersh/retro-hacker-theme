{
    //════════════════════════════════════════════════════════════════════════
    // RETRO HACKER BLUE v2 · fosforo azul frio sobre azul-negro, terminal IBM
    // Archivo GENERADO por build/generate.js desde build/palettes/blue.js: no editar a mano.
    //════════════════════════════════════════════════════════════════════════
    // Paleta (rol → hex → significado). * = valor por defecto (fallback) del rol
    // ── Fondos ──────────────────────────────────────────────────────────────
    // bg0                    #010111    fondo del editor, gutter, sticky scroll
    // bgDeep                 #00000A    fondo mas profundo: terminal, tab activa
    // bg1                    #010216    sidebar, region sin cambios del diff
    // bg2                    #030A26    panel, output, sticky del terminal
    // bg3                    #081636    widgets: find, suggest, hover, inputs, menus, quick input
    // bg4                    #11285A    headers elevados: peek title, keybinding label, banner
    // bgPeek                 #040E2E    editor del peek view
    // bgHover                #0F2350    hover del sticky scroll (editor y terminal)
    // bgActive               #0A2A5C    base del hover de tabs (se usa con alpha)
    // lineHighlight          #0C2B5E7A  linea activa (scanline), admite alpha
    // lineHighlightBorder    #12397E7C  borde de la linea activa, admite alpha
    // bgSideHeader           #020624    headers de seccion del sidebar
    // bgActivityBar          #001534    activity bar
    // bgTitleBar             #001538    title bar activa
    // bgTitleBarInactive     #010B22    title bar sin foco
    // bgCommandCenter        #041A42    command center
    // bgCommandCenterActive  #0A2A5C    command center activo
    // bgStatusBar            #00163E    status bar
    // errorBg                #2A0712    fondo opaco de validacion: error
    // warningBg              #2A2008    fondo opaco de validacion: warning
    // infoBg                 #032A2C    fondo opaco de validacion: info
    // exceptionBg            #1A0510    widget de excepcion del debugger
    // ── Bordes ──────────────────────────────────────────────────────────────
    // border                 #316CBD    bordes estructurales (sidebar, panel, tabs, widgets)
    // focus                  #4C9EEB    focusBorder, inputs, widgets activos, badge
    // borderDim              #15306A    separadores suaves, overview ruler
    // ── UI: acentos y texto ─────────────────────────────────────────────────
    // uiAccent               #5EAFFF    IDENTIDAD: acento UI, foreground general, botones, iconos
    // uiAccentAlt            #7FE9FF    acento secundario: highlight con foco en listas/suggest, headers del sidebar
    // uiAccentCool           #3FE0C5    acento frio: cursores secundarios, renamed, pasos del debugger, chat
    // uiAccentWarm           #FFD24A    acento calido: lightbulb, estrellas, pickerGroup, sin carpeta
    // onAccent               #000010    texto sobre rellenos de uiAccent (botones, badges, remoto)
    // onSignal               #000000    texto sobre rellenos de error/warning/debug/offline
    // cursor                 #7CBEFF    cursor del editor y del terminal
    // uiText                 #6FA6E8    texto de sidebar, descripciones
    // uiTitle                #7CB4F5    titulo del sidebar
    // uiTextBright           #FFFFFF    texto de items seleccionados / en hover
    // uiTextSoft             #DDF0FF    texto de seleccion inactiva en listas
    // textNeutral            #B4C8E8    texto de lineas en el resultado del peek
    // textDim                #6296DA    texto secundario: tabs inactivas, codelens, puntuacion de markup
    // tabUnfocusedText       #4876B0    tabs inactivas de un grupo sin foco
    // textGhost              #7488B6    ghost text, blame, placeholders, tachado
    // textDisabled           #5C70A0    elementos deshabilitados
    // ignored                #5A72A8    archivos ignorados por git
    // inactiveIcon           #647AAA    iconos inactivos (breakpoint deshabilitado, test sin correr)
    // lineNumber             #4F86C8    numeros de linea, guia de indent activa
    // guide                  #13306A    guias de indentacion
    // guideStrong            #2C5AA0    whitespace, guias del arbol, numeros de linea atenuados
    // terminalText           #A0CCFF    texto del terminal
    // inlayHint              #7FA4D8    inlay hints (parametros)
    // inlayHintType          #62B8B0    inlay hints de tipo
    // ── Estados ─────────────────────────────────────────────────────────────
    // error                  #FF5050    SOLO errores, invalid, breakpoints
    // errorSoft              #FF7878    errores en listas, hover de error, referencias sin resolver
    // warning                #FFD24A    warnings, deprecated
    // warningHover           #FFE07A    hover del item warning de la status bar
    // info                   #3FE0C5    info, consola de debug, alertas note
    // success                #8EF0A0    tests pasados, comando exitoso, start del debugger
    // attention              #FFA94D    conflictos git, offline, alertas important, sponsor
    // attentionHover         #FFC07A    hover del item offline
    // debug                  #FFA94D    status bar en debug, stack frame en pausa
    // ── Diff y control de versiones ─────────────────────────────────────────
    // inserted               #8EF0A0    texto agregado: markup.inserted, archivos agregados, lineas +
    // deleted                #FF5050    texto/gutter borrado
    // modified               #FFD24A    gutter y archivos modificados, tab modificada
    // changed                #FFA94D    markup.changed en diffs
    // diffAdded              #3FD080    gutter agregado y fondos de diff agregado (con alpha)
    // mergeCurrent           #3FD080    merge: current
    // mergeIncoming          #3FE0C5    merge: incoming
    // mergeBase              #B98CFF    merge: base comun
    // ── Highlights ──────────────────────────────────────────────────────────
    // selection              #4C9EEB    seleccion y sus ocurrencias (con alpha)
    // findMatch              #FFA94D    resultados de busqueda (con alpha)
    // highlightRead          #5EAFFF    word highlight de lectura (con alpha)
    // highlightWrite         #3FE0C5    word highlight de escritura, linked editing (con alpha)
    // bracketMatch           #7FE9FF    bracket match
    // bracket1               #5EAFFF    ciclo de brackets: nivel 1/4
    // bracket2               #B98CFF    ciclo de brackets: nivel 2/5
    // bracket3               #FFD24A    ciclo de brackets: nivel 3/6
    // ── Sintaxis ────────────────────────────────────────────────────────────
    // text                   #E4ECFF    IDENTIDAD: editor.foreground, texto JSX, codigo embebido
    // keyword                #5EAFFF    keywords, storage, imports, directivas
    // tag                    #5EAFFF    tags HTML/XML, selectores de tag CSS
    // func                   #7FE9FF    funciones, metodos, decorators, selectores de clase CSS
    // type                   #B98CFF    tipos, clases, interfaces, componentes
    // namespace              #D8B0FF    namespaces, modulos, type params, lifetimes, fechas de log
    // variable               #C8DCFF    variables
    // parameter              #C8DCFF    parametros
    // property               #3FE0C5    propiedades, keys JSON/YAML/CSS/ini
    // attribute              #3FE0C5    atributos de markup
    // string                 #8EF0A0    strings, valores CSS/dotenv
    // number                 #FFD24A    numeros, booleans, null, constantes del lenguaje
    // constant               #FFD24A    constantes UPPER_CASE/readonly, enum members, labels
    // regexp                 #FF85C8    expresiones regulares
    // escape                 #FF85C8    escapes, placeholders, delimitadores ${ }, entidades
    // special                #FF85C8    macros, !important, eventos
    // comment                #8790B8    comentarios, citas Markdown
    // operator               #4FC0E0    operadores, separadores
    // punctuation            #5A8CDA    puntuacion y brackets (sin colorizar)
    // selfVar                #FFA94D    this / self / super / cls
    // link                   #3FE0C5    links (UI y URLs de Markdown)
    // linkActive             #7FE9FF    link activo, texto de links Markdown
    // markupHeading          #5EAFFF    headings Markdown, secciones INI
    // markupBold             #8CCBFF    Markdown bold
    // markupItalic           #C8DCFF    Markdown italic
    // markupCode             #FFD24A    codigo inline (Markdown, hovers)
    // ── Terminal: paleta ANSI 16 ────────────────────────────────────────────
    // ansiBlack              #0A1430    terminal.ansiBlack
    // ansiRed                #FF5050    terminal.ansiRed
    // ansiGreen              #4FD88A    terminal.ansiGreen
    // ansiYellow             #FFD24A    terminal.ansiYellow
    // ansiBlue               #3B85E8    terminal.ansiBlue
    // ansiMagenta            #B86CFF    terminal.ansiMagenta
    // ansiCyan               #00C8D8    terminal.ansiCyan
    // ansiWhite              #9AA8C4    terminal.ansiWhite
    // ansiBrightBlack        #64789E    terminal.ansiBrightBlack
    // ansiBrightRed          #FF7878    terminal.ansiBrightRed
    // ansiBrightGreen        #8EF0A0    terminal.ansiBrightGreen
    // ansiBrightYellow       #FFEF7A    terminal.ansiBrightYellow
    // ansiBrightBlue         #5EAFFF    terminal.ansiBrightBlue
    // ansiBrightMagenta      #E0A0FF    terminal.ansiBrightMagenta
    // ansiBrightCyan         #5FF5FF    terminal.ansiBrightCyan
    // ansiBrightWhite        #F0F6FF    terminal.ansiBrightWhite
    // ── fontStyle ───────────────────────────────────────────────────────────
    // comment=italic · keyword=bold · tag=bold · declaration=bold · parameter=italic · selfVar=bold italic · decorator=italic · attribute=italic · heading=bold
    // ── Reglas de la casa ───────────────────────────────────────────────────
    // · rojo solo para errores · magenta solo en la paleta ANSI
    // · bold = keywords, tags y declaraciones; nunca expresiones completas (meta.*)
    // · seleccion azul haz, find ambar, word highlight azul (lectura) / teal (escritura)
    //════════════════════════════════════════════════════════════════════════
    "$schema": "vscode://schemas/color-theme",
    "name": "Retro Hacker Blue",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        // ── Base: texto, foco, sombras (glow del acento)
        "foreground": "#5EAFFF",
        "descriptionForeground": "#6FA6E8",
        "disabledForeground": "#5C70A0",
        "errorForeground": "#FF5050",
        "focusBorder": "#4C9EEB",
        "icon.foreground": "#5EAFFF",
        "selection.background": "#4C9EEB40",
        "widget.border": "#4C9EEB",
        "widget.shadow": "#5EAFFF26",
        "sash.hoverBorder": "#5EAFFF",
        "scrollbar.shadow": "#5EAFFF1A",
        "textLink.foreground": "#3FE0C5",
        "textLink.activeForeground": "#7FE9FF",
        "textBlockQuote.background": "#081636",
        "textBlockQuote.border": "#4C9EEB",
        "textCodeBlock.background": "#081636",
        "textPreformat.background": "#5EAFFF12",
        "textPreformat.foreground": "#FFD24A",
        "textSeparator.foreground": "#316CBD",
