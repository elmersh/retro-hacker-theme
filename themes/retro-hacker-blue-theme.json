    "semanticTokenColors": {
        // ── Tipos base
        "namespace": "#D8B0FF",
        "type": "#B98CFF",
        "class": "#B98CFF",
        "struct": "#B98CFF",
        "enum": "#B98CFF",
        "interface": { "foreground": "#B98CFF", "italic": true },
        "typeParameter": { "foreground": "#D8B0FF", "italic": true },
        "function": "#7FE9FF",
        "method": "#7FE9FF",
        "macro": { "foreground": "#FF85C8", "bold": true },
        "decorator": { "foreground": "#7FE9FF", "italic": true },
        "variable": "#C8DCFF",
        "parameter": { "foreground": "#C8DCFF", "italic": true },
        "property": "#3FE0C5",
        "enumMember": "#FFD24A",
        "event": "#FF85C8",
        "label": { "foreground": "#FFD24A", "italic": true },
        "keyword": "#5EAFFF",
        "modifier": "#5EAFFF",
        "comment": { "foreground": "#8790B8", "italic": true },
        "string": "#8EF0A0",
        "number": "#FFD24A",
        "regexp": "#FF85C8",
        "operator": "#4FC0E0",

        // ── Modificadores: declaraciones (fontStyle.declaration, solo simbolos grandes)
        "function.declaration": { "bold": true },
        "method.declaration": { "bold": true },
        "class.declaration": { "bold": true },
        "struct.declaration": { "bold": true },
        "interface.declaration": { "bold": true },
        "enum.declaration": { "bold": true },
        "type.declaration": { "bold": true },
        "namespace.declaration": { "bold": true },

        // ── Modificadores: readonly / constantes (constant)
        "variable.readonly": "#C8DCFF",
        "property.readonly": "#3FE0C5",
        "variable.readonly.defaultLibrary": "#FFD24A",
        "property.readonly.defaultLibrary": { "foreground": "#FFD24A", "italic": true },

        // ── Modificadores: libreria estandar (italic)
        "variable.defaultLibrary": { "foreground": "#D8B0FF", "italic": true },
        "function.defaultLibrary": { "foreground": "#7FE9FF", "italic": true },
        "method.defaultLibrary": { "foreground": "#7FE9FF", "italic": true },
        "class.defaultLibrary": { "foreground": "#B98CFF", "italic": true },
        "type.defaultLibrary": { "foreground": "#B98CFF", "italic": true },
        "interface.defaultLibrary": { "foreground": "#B98CFF", "italic": true },
        "namespace.defaultLibrary": { "foreground": "#D8B0FF", "italic": true },
        "property.defaultLibrary": { "foreground": "#3FE0C5", "italic": true },

        // ── Modificadores: estado
        "*.deprecated": { "strikethrough": true },
        "*.async": { "italic": true },
        "*.static": { "italic": true },
        "*.abstract": { "italic": true },

        // ── Python (Pylance)
        "selfParameter": { "foreground": "#FFA94D", "bold": true, "italic": true },
        "clsParameter": { "foreground": "#FFA94D", "bold": true, "italic": true },
        "magicFunction": { "foreground": "#7FE9FF", "italic": true },
        "builtinConstant": "#FFD24A",
        "module": "#D8B0FF",

        // ── Rust (rust-analyzer) y C/C++ (clangd)
        "selfKeyword": { "foreground": "#FFA94D", "bold": true, "italic": true },
        "selfTypeKeyword": { "foreground": "#B98CFF", "bold": true, "italic": true },
        "lifetime": { "foreground": "#D8B0FF", "italic": true },
        "builtinType": "#B98CFF",
        "typeAlias": "#B98CFF",
        "trait": { "foreground": "#B98CFF", "italic": true },
        "attribute": { "foreground": "#7FE9FF", "italic": true },
        "builtinAttribute": { "foreground": "#7FE9FF", "italic": true },
        "formatSpecifier": "#FF85C8",
        "escapeSequence": "#FF85C8",
        "unresolvedReference": { "foreground": "#FF7878", "underline": true },
        "boolean": "#FFD24A",
        "character": "#FFD24A",
        "constParameter": { "foreground": "#FFD24A", "italic": true }
    }
}
