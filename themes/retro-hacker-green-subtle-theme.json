{
    //════════════════════════════════════════════════════════════════════════
    // RETRO HACKER GREEN SUBTLE v2 · verde matrix calmado sobre negro puro, strings en oro suave
    // Archivo GENERADO por build/generate.js desde build/palettes/green-subtle.js: no editar a mano.
    //════════════════════════════════════════════════════════════════════════
    // Paleta (rol → hex → significado). * = valor por defecto (fallback) del rol
    // ── Fondos ──────────────────────────────────────────────────────────────
    // bg0                    #000000    fondo del editor, gutter, sticky scroll
    // bgDeep                 #000000    fondo mas profundo: terminal, tab activa
    // bg1                    #000C03    sidebar, region sin cambios del diff
    // bg2                    #030F06    panel, output, sticky del terminal
    // bg3                    #08190D    widgets: find, suggest, hover, inputs, menus, quick input
    // bg4                    #103018    headers elevados: peek title, keybinding label, banner
    // bgPeek                 #03130A    editor del peek view
    // bgHover                #0F2A16    hover del sticky scroll (editor y terminal)
    // bgActive               #002A0C    base del hover de tabs (se usa con alpha)
    // lineHighlight          #0F2A1680  linea activa (scanline), admite alpha
    // lineHighlightBorder    #1A4A2440  borde de la linea activa, admite alpha
    // bgSideHeader           #010F05    headers de seccion del sidebar
    // bgActivityBar          #000C03    activity bar
    // bgTitleBar             #030F06    title bar activa
    // bgTitleBarInactive     #000C03    title bar sin foco
    // bgCommandCenter        #051208    command center
    // bgCommandCenterActive  #00260B    command center activo
    // bgStatusBar            #000F04    status bar
    // errorBg                #260808    fondo opaco de validacion: error
    // warningBg              #261606    fondo opaco de validacion: warning
    // infoBg                 #04202A    fondo opaco de validacion: info
    // exceptionBg            #180505    widget de excepcion del debugger
    // ── Bordes ──────────────────────────────────────────────────────────────
    // border                 #1F8A3A    bordes estructurales (sidebar, panel, tabs, widgets)
    // focus                  #2FBF55    focusBorder, inputs, widgets activos, badge
    // borderDim              #123A1C    separadores suaves, overview ruler
    // ── UI: acentos y texto ─────────────────────────────────────────────────
    // uiAccent               #00FF41    IDENTIDAD: acento UI, foreground general, botones, iconos
    // uiAccentAlt            #B4E05C    acento secundario: highlight con foco en listas/suggest, headers del sidebar
    // uiAccentCool           #62C9D9    acento frio: cursores secundarios, renamed, pasos del debugger, chat
    // uiAccentWarm           #E6C450    acento calido: lightbulb, estrellas, pickerGroup, sin carpeta
    // onAccent               #000000    texto sobre rellenos de uiAccent (botones, badges, remoto)
    // onSignal               #000000    texto sobre rellenos de error/warning/debug/offline
    // cursor                 #00FF41    cursor del editor y del terminal
    // uiText                 #45C463    texto de sidebar, descripciones
    // uiTitle                #3FCC60    titulo del sidebar
    // uiTextBright           #E8FFEC    texto de items seleccionados / en hover
    // uiTextSoft             #CCEFD3    texto de seleccion inactiva en listas
    // textNeutral            #B0D4B8    texto de lineas en el resultado del peek
    // textDim                #40B05C    texto secundario: tabs inactivas, codelens, puntuacion de markup
    // tabUnfocusedText       #2F8545    tabs inactivas de un grupo sin foco
    // textGhost              #6E9E78    ghost text, blame, placeholders, tachado
    // textDisabled           #4D7A56    elementos deshabilitados
    // ignored                #4F8A5A    archivos ignorados por git
    // inactiveIcon           #5C8466    iconos inactivos (breakpoint deshabilitado, test sin correr)
    // lineNumber             #3A9A52    numeros de linea, guia de indent activa
    // guide                  #163F20    guias de indentacion
    // guideStrong            #2E7040    whitespace, guias del arbol, numeros de linea atenuados
    // terminalText           #2FE060    texto del terminal
    // inlayHint              #7DB88A    inlay hints (parametros)
    // inlayHintType          #6CB3B0    inlay hints de tipo
    // ── Estados ─────────────────────────────────────────────────────────────
    // error                  #FF4848    SOLO errores, invalid, breakpoints
    // errorSoft              #FF7F7F    errores en listas, hover de error, referencias sin resolver
    // warning                #E8964A    warnings, deprecated
    // warningHover           #F2AE6E    hover del item warning de la status bar
    // info                   #62C9D9    info, consola de debug, alertas note
    // success                #00FF41    tests pasados, comando exitoso, start del debugger
    // attention              #F0906E    conflictos git, offline, alertas important, sponsor
    // attentionHover         #EB907E    hover del item offline
    // debug                  #E8964A    status bar en debug, stack frame en pausa
    // ── Diff y control de versiones ─────────────────────────────────────────
    // inserted               #00FF41    texto agregado: markup.inserted, archivos agregados, lineas +
    // deleted                #FF4848    texto/gutter borrado
    // modified               #E6C450    gutter y archivos modificados, tab modificada
    // changed                #E8964A    markup.changed en diffs
    // diffAdded              #00FF41    gutter agregado y fondos de diff agregado (con alpha)
    // mergeCurrent           #00FF41    merge: current
    // mergeIncoming          #62C9D9    merge: incoming
    // mergeBase              #E6C450    merge: base comun
    // ── Highlights ──────────────────────────────────────────────────────────
    // selection              #1FB84A    seleccion y sus ocurrencias (con alpha)
    // findMatch              #E6C450    resultados de busqueda (con alpha)
    // highlightRead          #B4E05C    word highlight de lectura (con alpha)
    // highlightWrite         #62C9D9    word highlight de escritura, linked editing (con alpha)
    // bracketMatch           #B4E05C    bracket match
    // bracket1               #00E03A    ciclo de brackets: nivel 1/4
    // bracket2               #62C9D9    ciclo de brackets: nivel 2/5
    // bracket3               #E8964A    ciclo de brackets: nivel 3/6
    // ── Sintaxis ────────────────────────────────────────────────────────────
    // text                   #7CE896    IDENTIDAD: editor.foreground, texto JSX, codigo embebido
    // keyword                #00FF41    keywords, storage, imports, directivas
    // tag                    #00E03A    tags HTML/XML, selectores de tag CSS
    // func                   #B4E05C    funciones, metodos, decorators, selectores de clase CSS
    // type                   #62C9D9    tipos, clases, interfaces, componentes
    // namespace              #45AC92    namespaces, modulos, type params, lifetimes, fechas de log
    // variable               #BCE8C4    variables
    // parameter              #BCE8C4    parametros
    // property               #2EDCBC    propiedades, keys JSON/YAML/CSS/ini
    // attribute              #2EDCBC    atributos de markup
    // string                 #E6C450    strings, valores CSS/dotenv
    // number                 #E8964A    numeros, booleans, null, constantes del lenguaje
    // constant               #E8964A    constantes UPPER_CASE/readonly, enum members, labels
    // regexp                 #F0906E    expresiones regulares
    // escape                 #F0906E    escapes, placeholders, delimitadores ${ }, entidades
    // special                #F0906E    macros, !important, eventos
    // comment                #7C9A72    comentarios, citas Markdown
    // operator               #A9BC2E    operadores, separadores
    // punctuation            #30B856    puntuacion y brackets (sin colorizar)
    // selfVar                #E6C450    this / self / super / cls
    // link                   #62C9D9    links (UI y URLs de Markdown)
    // linkActive             #45AC92    link activo, texto de links Markdown
    // markupHeading          #00FF41    headings Markdown, secciones INI
    // markupBold             #00FF41    Markdown bold
    // markupItalic           #BCE8C4    Markdown italic
    // markupCode             #E8964A    codigo inline (Markdown, hovers)
    // ── Terminal: paleta ANSI 16 ────────────────────────────────────────────
    // ansiBlack              #0C1A10    terminal.ansiBlack
    // ansiRed                #FF4848    terminal.ansiRed
    // ansiGreen              #00E03A    terminal.ansiGreen
    // ansiYellow             #E6C450    terminal.ansiYellow
    // ansiBlue               #4C95F0    terminal.ansiBlue
    // ansiMagenta            #C076F0    terminal.ansiMagenta
    // ansiCyan               #3FB8C4    terminal.ansiCyan
    // ansiWhite              #B0D4B8    terminal.ansiWhite
    // ansiBrightBlack        #5C8466    terminal.ansiBrightBlack
    // ansiBrightRed          #FF7F7F    terminal.ansiBrightRed
    // ansiBrightGreen        #7CFF9A    terminal.ansiBrightGreen
    // ansiBrightYellow       #FFE07A    terminal.ansiBrightYellow
    // ansiBrightBlue         #85B5FF    terminal.ansiBrightBlue
    // ansiBrightMagenta      #E0A0FF    terminal.ansiBrightMagenta
    // ansiBrightCyan         #7FE6EE    terminal.ansiBrightCyan
    // ansiBrightWhite        #EAF7EC    terminal.ansiBrightWhite
    // ── fontStyle ───────────────────────────────────────────────────────────
    // comment=italic · keyword=bold · tag=bold · declaration=bold · parameter=italic · selfVar=bold italic · decorator=italic · attribute=italic · heading=bold
    // ── Reglas de la casa ───────────────────────────────────────────────────
    // · rojo solo para errores · azul/magenta solo en la paleta ANSI
    // · chrome callado: scanline casi invisible, bordes y numeros de linea tenues
    // · seleccion verde, find oro, word highlight lima (lectura) / aqua (escritura)
    //════════════════════════════════════════════════════════════════════════
    "$schema": "vscode://schemas/color-theme",
    "name": "Retro Hacker Green - Subtle",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
