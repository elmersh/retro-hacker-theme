    "tokenColors": [
        // ── Base: comentarios, strings, literales
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "string.comment"
            ],
            "settings": {
                "foreground": "#7C9A72",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Doc comment tags",
            "scope": [
                "storage.type.class.jsdoc",
                "keyword.other.phpdoc",
                "storage.type.class.doxygen",
                "keyword.other.documentation",
                "comment.block.documentation keyword",
                "comment.block.documentation storage.type"
            ],
            "settings": {
                "foreground": "#7C9A72",
                "fontStyle": "bold italic"
            }
        },
        {
            "name": "Doc comment types",
            "scope": [
                "entity.name.type.instance.jsdoc",
                "comment.block.documentation entity.name.type",
                "comment.block.documentation support.type"
            ],
            "settings": {
                "foreground": "#45AC92",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Doc comment params",
            "scope": [
                "variable.other.jsdoc",
                "comment.block.documentation variable"
            ],
            "settings": {
                "foreground": "#BCE8C4",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.interpolated",
                "string.unquoted",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#E6C450",
                "fontStyle": ""
            }
        },
        {
            "name": "Template / interpolation delimiters",
