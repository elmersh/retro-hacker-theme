    "semanticTokenColors": {
        // ── Tipos base
        "namespace": "#45AC92",
        "type": "#62C9D9",
        "class": "#62C9D9",
        "struct": "#62C9D9",
        "enum": "#62C9D9",
        "interface": { "foreground": "#62C9D9", "italic": true },
        "typeParameter": { "foreground": "#45AC92", "italic": true },
        "function": "#B4E05C",
        "method": "#B4E05C",
        "macro": { "foreground": "#F0906E", "bold": true },
        "decorator": { "foreground": "#B4E05C", "italic": true },
        "variable": "#BCE8C4",
        "parameter": { "foreground": "#BCE8C4", "italic": true },
        "property": "#2EDCBC",
        "enumMember": "#E8964A",
        "event": "#F0906E",
        "label": { "foreground": "#E8964A", "italic": true },
        "keyword": "#00FF41",
        "modifier": "#00FF41",
        "comment": { "foreground": "#7C9A72", "italic": true },
        "string": "#E6C450",
        "number": "#E8964A",
        "regexp": "#F0906E",
        "operator": "#A9BC2E",

        // ── Modificadores: declaraciones (fontStyle.declaration, solo simbolos grandes)
        "function.declaration": { "bold": true },
        "method.declaration": { "bold": true },
        "class.declaration": { "bold": true },
        "struct.declaration": { "bold": true },
        "interface.declaration": { "bold": true },
        "enum.declaration": { "bold": true },
        "type.declaration": { "bold": true },
        "namespace.declaration": { "bold": true },

        // ── Modificadores: readonly / constantes (constant)
        "variable.readonly": "#BCE8C4",
        "property.readonly": "#2EDCBC",
        "variable.readonly.defaultLibrary": "#E8964A",
        "property.readonly.defaultLibrary": { "foreground": "#E8964A", "italic": true },

        // ── Modificadores: libreria estandar (italic)
        "variable.defaultLibrary": { "foreground": "#45AC92", "italic": true },
        "function.defaultLibrary": { "foreground": "#B4E05C", "italic": true },
        "method.defaultLibrary": { "foreground": "#B4E05C", "italic": true },
        "class.defaultLibrary": { "foreground": "#62C9D9", "italic": true },
        "type.defaultLibrary": { "foreground": "#62C9D9", "italic": true },
        "interface.defaultLibrary": { "foreground": "#62C9D9", "italic": true },
        "namespace.defaultLibrary": { "foreground": "#45AC92", "italic": true },
        "property.defaultLibrary": { "foreground": "#2EDCBC", "italic": true },

        // ── Modificadores: estado
        "*.deprecated": { "strikethrough": true },
        "*.async": { "italic": true },
        "*.static": { "italic": true },
        "*.abstract": { "italic": true },

        // ── Python (Pylance)
        "selfParameter": { "foreground": "#E6C450", "bold": true, "italic": true },
        "clsParameter": { "foreground": "#E6C450", "bold": true, "italic": true },
        "magicFunction": { "foreground": "#B4E05C", "italic": true },
        "builtinConstant": "#E8964A",
        "module": "#45AC92",

        // ── Rust (rust-analyzer) y C/C++ (clangd)
        "selfKeyword": { "foreground": "#E6C450", "bold": true, "italic": true },
        "selfTypeKeyword": { "foreground": "#62C9D9", "bold": true, "italic": true },
        "lifetime": { "foreground": "#45AC92", "italic": true },
        "builtinType": "#62C9D9",
        "typeAlias": "#62C9D9",
        "trait": { "foreground": "#62C9D9", "italic": true },
        "attribute": { "foreground": "#B4E05C", "italic": true },
        "builtinAttribute": { "foreground": "#B4E05C", "italic": true },
        "formatSpecifier": "#F0906E",
        "escapeSequence": "#F0906E",
        "unresolvedReference": { "foreground": "#FF7F7F", "underline": true },
        "boolean": "#E8964A",
        "character": "#E8964A",
        "constParameter": { "foreground": "#E8964A", "italic": true }
    }
}
