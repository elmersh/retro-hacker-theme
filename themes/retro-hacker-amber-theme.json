{
    //════════════════════════════════════════════════════════════════════════
    // RETRO HACKER AMBER v2 · fosforo ambar CRT sobre negro calido
    // Archivo GENERADO por build/generate.js desde build/palettes/amber.js: no editar a mano.
    //════════════════════════════════════════════════════════════════════════
    // Paleta (rol → hex → significado). * = valor por defecto (fallback) del rol
    // ── Fondos ──────────────────────────────────────────────────────────────
    // bg0                    #1A1006    fondo del editor, gutter, sticky scroll
    // bgDeep                 #110A03    fondo mas profundo: terminal, tab activa
    // bg1                    #150D05    sidebar, region sin cambios del diff
    // bg2                    #1F140A    panel, output, sticky del terminal
    // bg3                    #291B0C    widgets: find, suggest, hover, inputs, menus, quick input
    // bg4                    #3D2A12    headers elevados: peek title, keybinding label, banner
    // bgPeek                 #20150A    editor del peek view
    // bgHover                #36240F    hover del sticky scroll (editor y terminal)
    // bgActive               #3D2600    base del hover de tabs (se usa con alpha)
    // lineHighlight          #2E1E0C7A  linea activa (scanline), admite alpha
    // lineHighlightBorder    #6A40107C  borde de la linea activa, admite alpha
    // bgSideHeader           #1A1007    headers de seccion del sidebar
    // bgActivityBar          #1C1208    activity bar
    // bgTitleBar             #1C1107    title bar activa
    // bgTitleBarInactive     #150D05    title bar sin foco
    // bgCommandCenter        #22160A    command center
    // bgCommandCenterActive  #3A2400    command center activo
    // bgStatusBar            #1A1006    status bar
    // errorBg                #3A0E0C    fondo opaco de validacion: error
    // warningBg              #33300A    fondo opaco de validacion: warning
    // infoBg                 #0E2A28    fondo opaco de validacion: info
    // exceptionBg            #2A0C08    widget de excepcion del debugger
    // ── Bordes ──────────────────────────────────────────────────────────────
    // border                 #A87000    bordes estructurales (sidebar, panel, tabs, widgets)
    // focus                  #E09A00    focusBorder, inputs, widgets activos, badge
    // borderDim              #4A3014    separadores suaves, overview ruler
    // ── UI: acentos y texto ─────────────────────────────────────────────────
    // uiAccent               #FFB000    IDENTIDAD: acento UI, foreground general, botones, iconos
    // uiAccentAlt            #FFE14D    acento secundario: highlight con foco en listas/suggest, headers del sidebar
    // uiAccentCool           #6FE0E0    acento frio: cursores secundarios, renamed, pasos del debugger, chat
    // uiAccentWarm           #FF8C1A    acento calido: lightbulb, estrellas, pickerGroup, sin carpeta
    // onAccent               #000000    texto sobre rellenos de uiAccent (botones, badges, remoto)
    // onSignal               #000000    texto sobre rellenos de error/warning/debug/offline
    // cursor                 #FFB000    cursor del editor y del terminal
    // uiText                 #E0A030    texto de sidebar, descripciones
    // uiTitle                #F0AA20    titulo del sidebar
    // uiTextBright           #FFF6E6    texto de items seleccionados / en hover
    // uiTextSoft             #FFE8C8    texto de seleccion inactiva en listas
    // textNeutral            #E0C8A8    texto de lineas en el resultado del peek
    // textDim                #CC9238    texto secundario: tabs inactivas, codelens, puntuacion de markup
    // tabUnfocusedText       #9A7030    tabs inactivas de un grupo sin foco
    // textGhost              #A89070    ghost text, blame, placeholders, tachado
    // textDisabled           #857050    elementos deshabilitados
    // ignored                #937856    archivos ignorados por git
    // inactiveIcon           #8E7656    iconos inactivos (breakpoint deshabilitado, test sin correr)
    // lineNumber             #C78021    numeros de linea, guia de indent activa
    // guide                  #3F2A12    guias de indentacion
    // guideStrong            #865E28    whitespace, guias del arbol, numeros de linea atenuados
    // terminalText           #F5A800    texto del terminal
    // inlayHint              #C8A878    inlay hints (parametros)
    // inlayHintType          #7FBFB8    inlay hints de tipo
    // ── Estados ─────────────────────────────────────────────────────────────
    // error                  #FF4040    SOLO errores, invalid, breakpoints
    // errorSoft              #FF7A7A    errores en listas, hover de error, referencias sin resolver
    // warning                #FFFF55    warnings, deprecated
    // warningHover           #FFFF99    hover del item warning de la status bar
    // info                   #6FE0E0    info, consola de debug, alertas note
    // success                #7FE05A    tests pasados, comando exitoso, start del debugger
    // attention              #FF7AA2    conflictos git, offline, alertas important, sponsor
    // attentionHover         #FF9AB8    hover del item offline
    // debug                  #FF8C1A    status bar en debug, stack frame en pausa
    // ── Diff y control de versiones ─────────────────────────────────────────
    // inserted               #7FE05A    texto agregado: markup.inserted, archivos agregados, lineas +
    // deleted                #FF4040    texto/gutter borrado
    // modified               #FFE14D    gutter y archivos modificados, tab modificada
    // changed                #FFFF55    markup.changed en diffs
    // diffAdded              #4CAF30    gutter agregado y fondos de diff agregado (con alpha)
    // mergeCurrent           #4CAF30    merge: current
    // mergeIncoming          #6FE0E0    merge: incoming
    // mergeBase              #D98500    merge: base comun
    // ── Highlights ──────────────────────────────────────────────────────────
    // selection              #E09400    seleccion y sus ocurrencias (con alpha)
    // findMatch              #00A8A8    resultados de busqueda (con alpha)
    // highlightRead          #FFE14D    word highlight de lectura (con alpha)
    // highlightWrite         #FF7AA2    word highlight de escritura, linked editing (con alpha)
    // bracketMatch           #FFE14D    bracket match
    // bracket1               #FF8C1A    ciclo de brackets: nivel 1/4
    // bracket2               #6FE0E0    ciclo de brackets: nivel 2/5
    // bracket3               #FFE14D    ciclo de brackets: nivel 3/6
    // ── Sintaxis ────────────────────────────────────────────────────────────
    // text                   #FFB000    IDENTIDAD: editor.foreground, texto JSX, codigo embebido
    // keyword                #FF8C1A    keywords, storage, imports, directivas
    // tag                    #FF8C1A    tags HTML/XML, selectores de tag CSS
    // func                   #FFE14D    funciones, metodos, decorators, selectores de clase CSS
    // type                   #6FE0E0    tipos, clases, interfaces, componentes
    // namespace              #3FAE9C    namespaces, modulos, type params, lifetimes, fechas de log
    // variable               #FFD49C    variables
    // parameter              #FFD49C    parametros
    // property               #FFAD8C    propiedades, keys JSON/YAML/CSS/ini
    // attribute              #FFAD8C    atributos de markup
    // string                 #F2EDD6    strings, valores CSS/dotenv
    // number                 #D2D66A    numeros, booleans, null, constantes del lenguaje
    // constant               #C8E05A    constantes UPPER_CASE/readonly, enum members, labels
    // regexp                 #FF7AA2    expresiones regulares
    // escape                 #FF7AA2    escapes, placeholders, delimitadores ${ }, entidades
    // special                #FF7AA2    macros, !important, eventos
    // comment                #B39878    comentarios, citas Markdown
    // operator               #DDB088    operadores, separadores
    // punctuation            #D08E34    puntuacion y brackets (sin colorizar)
    // selfVar                #FFCB6B    this / self / super / cls
    // link                   #6FE0E0    links (UI y URLs de Markdown)
    // linkActive             #3FAE9C    link activo, texto de links Markdown
    // markupHeading          #FFB000    headings Markdown, secciones INI
    // markupBold             #FF8C1A    Markdown bold
    // markupItalic           #FFD49C    Markdown italic
    // markupCode             #C8E05A    codigo inline (Markdown, hovers)
    // ── Terminal: paleta ANSI 16 ────────────────────────────────────────────
    // ansiBlack              #2A1C0E    terminal.ansiBlack
    // ansiRed                #FF4040    terminal.ansiRed
    // ansiGreen              #8FD94A    terminal.ansiGreen
    // ansiYellow             #FFD54F    terminal.ansiYellow
    // ansiBlue               #5C9DFF    terminal.ansiBlue
    // ansiMagenta            #E070D8    terminal.ansiMagenta
    // ansiCyan               #4FC8C8    terminal.ansiCyan
    // ansiWhite              #E8D4B0    terminal.ansiWhite
    // ansiBrightBlack        #9A7F5A    terminal.ansiBrightBlack
    // ansiBrightRed          #FF7A7A    terminal.ansiBrightRed
    // ansiBrightGreen        #B4F070    terminal.ansiBrightGreen
    // ansiBrightYellow       #FFFF55    terminal.ansiBrightYellow
    // ansiBrightBlue         #8CBFFF    terminal.ansiBrightBlue
    // ansiBrightMagenta      #FF9AF0    terminal.ansiBrightMagenta
    // ansiBrightCyan         #7FF0F0    terminal.ansiBrightCyan
    // ansiBrightWhite        #FFF6E6    terminal.ansiBrightWhite
    // ── fontStyle ───────────────────────────────────────────────────────────
    // comment=italic · keyword=bold · tag=bold · declaration=bold · parameter=italic · selfVar=bold italic · decorator=italic · attribute=italic · heading=bold
    // ── Reglas de la casa ───────────────────────────────────────────────────
    // · rojo solo para errores · warning en limon, nunca ambar · azul/magenta solo en la paleta ANSI
    // · bold = keywords, tags y declaraciones; nunca expresiones completas (meta.*)
    // · seleccion ambar, find cyan, word highlight amarillo (lectura) / rosa (escritura)
    //════════════════════════════════════════════════════════════════════════
    "$schema": "vscode://schemas/color-theme",
    "name": "Retro Hacker Amber",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        // ── Base: texto, foco, sombras (glow del acento)
        "foreground": "#FFB000",
        "descriptionForeground": "#E0A030",
        "disabledForeground": "#857050",
        "errorForeground": "#FF4040",
        "focusBorder": "#E09A00",
        "icon.foreground": "#FFB000",
        "selection.background": "#E0940040",
        "widget.border": "#E09A00",
        "widget.shadow": "#FFB00026",
        "sash.hoverBorder": "#FFB000",
        "scrollbar.shadow": "#FFB0001A",
        "textLink.foreground": "#6FE0E0",
        "textLink.activeForeground": "#3FAE9C",
        "textBlockQuote.background": "#291B0C",
        "textBlockQuote.border": "#E09A00",
        "textCodeBlock.background": "#291B0C",
