    "semanticTokenColors": {
        // ── Tipos base
        "namespace": "#3FAE9C",
        "type": "#6FE0E0",
        "class": "#6FE0E0",
        "struct": "#6FE0E0",
        "enum": "#6FE0E0",
        "interface": { "foreground": "#6FE0E0", "italic": true },
        "typeParameter": { "foreground": "#3FAE9C", "italic": true },
        "function": "#FFE14D",
        "method": "#FFE14D",
        "macro": { "foreground": "#FF7AA2", "bold": true },
        "decorator": { "foreground": "#FFE14D", "italic": true },
        "variable": "#FFD49C",
        "parameter": { "foreground": "#FFD49C", "italic": true },
        "property": "#FFAD8C",
        "enumMember": "#C8E05A",
        "event": "#FF7AA2",
        "label": { "foreground": "#C8E05A", "italic": true },
        "keyword": "#FF8C1A",
        "modifier": "#FF8C1A",
        "comment": { "foreground": "#B39878", "italic": true },
        "string": "#F2EDD6",
        "number": "#D2D66A",
        "regexp": "#FF7AA2",
        "operator": "#DDB088",

        // ── Modificadores: declaraciones (fontStyle.declaration, solo simbolos grandes)
        "function.declaration": { "bold": true },
        "method.declaration": { "bold": true },
        "class.declaration": { "bold": true },
        "struct.declaration": { "bold": true },
        "interface.declaration": { "bold": true },
        "enum.declaration": { "bold": true },
        "type.declaration": { "bold": true },
        "namespace.declaration": { "bold": true },

        // ── Modificadores: readonly / constantes (constant)
        "variable.readonly": "#FFD49C",
        "property.readonly": "#FFAD8C",
        "variable.readonly.defaultLibrary": "#C8E05A",
        "property.readonly.defaultLibrary": { "foreground": "#C8E05A", "italic": true },

        // ── Modificadores: libreria estandar (italic)
        "variable.defaultLibrary": { "foreground": "#3FAE9C", "italic": true },
        "function.defaultLibrary": { "foreground": "#FFE14D", "italic": true },
        "method.defaultLibrary": { "foreground": "#FFE14D", "italic": true },
        "class.defaultLibrary": { "foreground": "#6FE0E0", "italic": true },
        "type.defaultLibrary": { "foreground": "#6FE0E0", "italic": true },
        "interface.defaultLibrary": { "foreground": "#6FE0E0", "italic": true },
        "namespace.defaultLibrary": { "foreground": "#3FAE9C", "italic": true },
        "property.defaultLibrary": { "foreground": "#FFAD8C", "italic": true },

        // ── Modificadores: estado
        "*.deprecated": { "strikethrough": true },
        "*.async": { "italic": true },
        "*.static": { "italic": true },
        "*.abstract": { "italic": true },

        // ── Python (Pylance)
        "selfParameter": { "foreground": "#FFCB6B", "bold": true, "italic": true },
        "clsParameter": { "foreground": "#FFCB6B", "bold": true, "italic": true },
        "magicFunction": { "foreground": "#FFE14D", "italic": true },
        "builtinConstant": "#D2D66A",
        "module": "#3FAE9C",

        // ── Rust (rust-analyzer) y C/C++ (clangd)
        "selfKeyword": { "foreground": "#FFCB6B", "bold": true, "italic": true },
        "selfTypeKeyword": { "foreground": "#6FE0E0", "bold": true, "italic": true },
        "lifetime": { "foreground": "#3FAE9C", "italic": true },
        "builtinType": "#6FE0E0",
        "typeAlias": "#6FE0E0",
        "trait": { "foreground": "#6FE0E0", "italic": true },
        "attribute": { "foreground": "#FFE14D", "italic": true },
        "builtinAttribute": { "foreground": "#FFE14D", "italic": true },
        "formatSpecifier": "#FF7AA2",
        "escapeSequence": "#FF7AA2",
        "unresolvedReference": { "foreground": "#FF7A7A", "underline": true },
        "boolean": "#D2D66A",
        "character": "#D2D66A",
        "constParameter": { "foreground": "#C8E05A", "italic": true }
    }
}
